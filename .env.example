# ==============================================================================
# H5 GAME PAYMENT GATEWAY - CẤU HÌNH HỆ THỐNG
# ==============================================================================

# Cổng máy chủ Gateway
PORT=3001
NODE_ENV=development

# Khóa bí mật API của Gateway (Dùng cho Game Server xác thực & ký HMAC)
GATEWAY_SECRET_KEY=gateway_secret_super_key_2026_!@#

# ------------------------------------------------------------------------------
# CẤU HÌNH NGÂN HÀNG & SEPAY (Tài khoản nhận tiền)
# ------------------------------------------------------------------------------
# SePay API Key (Lấy tại my.sepay.vn -> Tích hợp Webhook)
SEPAY_API_KEY=test_sepay_api_key_sandbox

# Thông tin tài khoản ngân hàng nhận tiền
BANK_CODE=MBBank
BANK_ACCOUNT_NUMBER=0987654321
BANK_ACCOUNT_NAME=NGUYEN VAN A

# Tiền tố mã thanh toán (Ví dụ: NAP, PAY, GAME...) -> Sinh ra cú pháp: PAY12345
PAYMENT_CODE_PREFIX=PAY

# Thời gian hết hạn của đơn nạp (Phút)
ORDER_EXPIRE_MINUTES=15

# ------------------------------------------------------------------------------
# CẤU HÌNH CƠ SỞ DỮ LIỆU (Mặc định: file, hoặc mysql)
# ------------------------------------------------------------------------------
DB_DRIVER=file

# Nếu dùng MySQL:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=game_payment_gateway

# ------------------------------------------------------------------------------
# CẤU HÌNH GAME SERVER CALLBACK (Mặc định hoặc cấu hình theo từng Game)
# ------------------------------------------------------------------------------
DEFAULT_GAME_CALLBACK_URL=http://127.0.0.1:80/api/payment_callback.php
